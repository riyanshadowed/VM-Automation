# MongoDB Connection (Optional: If empty, embedded local database is used automatically)
MONGODB_URI=

# Official Meta App Credentials
META_APP_ID=
META_APP_SECRET=

# Meta Webhook Verification Token (Match this with what you configure in Meta App Webhooks)
META_VERIFY_TOKEN=vyapar_automate_verify_token_123

# Instagram & Page Access Token (Long-lived Token with instagram_manage_comments, instagram_manage_messages)
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
